# PacGate-Law (百宸法律 AI) — Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in your values
#   3. Place in the same directory as docker-compose.prod.yaml
#
# ⚠ This file is gitignored. NEVER commit real credentials.

# ============================================================================
# Docker Compose required variables
# ============================================================================
DEER_FLOW_ROOT=.

# Frontend auth secret (must be non-empty for build)
BETTER_AUTH_SECRET=local-dev-pacgate-secret-change-in-production-2026

# Internal auth token (shared between gateway workers)
DEER_FLOW_INTERNAL_AUTH_TOKEN=local-dev-internal-token-change-me

# ============================================================================
# Model tier API keys + base URLs — Ollama local API
# ============================================================================
# From Docker: use host.docker.internal:11434
# From local dev (no Docker): use localhost:11434
# Ollama doesn't require a real API key (any non-empty string works).

PACGATE_MAIN_API_KEY=ollama
PACGATE_MAIN_API_BASE=http://host.docker.internal:11434/v1

PACGATE_MID_API_KEY=ollama
PACGATE_MID_API_BASE=http://host.docker.internal:11434/v1

PACGATE_LOW_API_KEY=ollama
PACGATE_LOW_API_BASE=http://host.docker.internal:11434/v1

# ============================================================================
# Legal MCP server credentials
# ============================================================================
# Fill in real values from each platform's developer console

# 元典 (yuandian) — one API key for all 3 servers
YUANDIAN_API_KEY=

# 北大法宝 (pkulaw) — Bearer Token
PKULAW_BEARER_TOKEN=

# 企查查 (qcc) — one API key for all servers
QCC_API_KEY=

# SEC EDGAR — free, just needs identifying User-Agent
SEC_EDGAR_USER_AGENT=PacGate-Law (contact@pacgate-law.com)

# ============================================================================
# OpenViking context DB
# ============================================================================
# Get from: your OpenViking deployment's root API key
OPENVIKING_API_KEY=
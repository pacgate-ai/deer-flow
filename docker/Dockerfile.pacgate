# PacGate-Law Production Image — all-in-one (backend + frontend + skills)
#
# This Dockerfile builds a single production image that contains:
#   - Backend (Python + PacGate middleware + all skills baked in)
#   - Frontend (Next.js production build)
#   - 34 PacGate skills (in /app/skills/public/)
#   - 5 role-tier agent templates (in /app/agents/)
#
# Client only needs to mount: config.yaml, extensions_config.json, .env
#
# Build: docker build -f docker/Dockerfile.pacgate -t ghcr.io/jzkk720/deer-flow-pacgate:latest .
# Pull:  docker pull ghcr.io/jzkk720/deer-flow-pacgate:latest

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.7.20
ARG PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim-bookworm
ARG DOCKER_CLI_IMAGE=docker.1ms.run/library/docker:cli
ARG NODE_IMAGE=node:22-alpine
ARG OFFICECLI_VERSION=1.0.139

# ── Stage 1: Backend Builder ──────────────────────────────────────────────────
FROM ${UV_IMAGE} AS uv-source
FROM ${DOCKER_CLI_IMAGE} AS docker-cli-source

FROM ${PYTHON_IMAGE} AS backend-builder
ARG NODE_MAJOR=22
ARG APT_MIRROR
ARG UV_INDEX_URL

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null || true; \
    fi

RUN apt-get update && apt-get install -y \
    curl build-essential gnupg ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-source /uv /uvx /usr/local/bin/
WORKDIR /app
COPY backend ./backend

RUN --mount=type=cache,target=/root/.cache/uv \
    cd backend && \
    UV_INDEX_URL=${UV_INDEX_URL:-https://pypi.org/simple} uv sync --extra redis

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8

# ── Stage 2: Frontend Builder ─────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS frontend-builder
RUN corepack enable && corepack install -g pnpm@10.26.2
WORKDIR /app
COPY frontend ./frontend
RUN cd /app/frontend && pnpm install --frozen-lockfile
ARG APP_VERSION=""
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION
RUN cd /app/frontend && SKIP_ENV_VALIDATION=1 pnpm build

# ── Stage 3: Runtime (clean) ──────────────────────────────────────────────────
FROM ${PYTHON_IMAGE} AS runtime

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8

# Copy Node.js from builder (for npx MCP servers)
COPY --from=backend-builder /usr/bin/node /usr/bin/node
COPY --from=backend-builder /usr/lib/node_modules /usr/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/bin/npx

# Docker CLI (for DooD sandbox)
COPY --from=docker-cli-source /usr/local/bin/docker /usr/local/bin/docker

# uv
COPY --from=uv-source /uv /uvx /usr/local/bin/

# OfficeCLI (Word/Excel/PPT automation)
ARG OFFICECLI_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends curl libicu72 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /usr/local/bin/officecli \
      "https://github.com/iOfficeAI/OfficeCLI/releases/download/v${OFFICECLI_VERSION}/officecli-linux-x64" \
    && chmod +x /usr/local/bin/officecli \
    && apt-get purge -y curl && apt-get autoremove -y

# markitdown-mcp + weasyprint (PDF generation)
RUN pip install --no-cache-dir markitdown-mcp weasyprint \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg libpango-1.0-0 libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Backend (with pre-built .venv) ────────────────────────────────────────────
COPY --from=backend-builder /app/backend ./backend

# ── Frontend (production build) ───────────────────────────────────────────────
COPY --from=frontend-builder /app/frontend/.next /app/frontend/.next
COPY --from=frontend-builder /app/frontend/public /app/frontend/public
COPY --from=frontend-builder /app/frontend/package.json /app/frontend/package.json
COPY --from=frontend-builder /app/frontend/pnpm-lock.yaml /app/frontend/pnpm-lock.yaml
COPY --from=frontend-builder /app/frontend/next.config.js /app/frontend/next.config.js
COPY --from=frontend-builder /app/frontend/node_modules /app/frontend/node_modules

# ── PacGate skills (baked in, not mounted) ────────────────────────────────────
COPY skills/public ./skills/public

# ── PacGate agent templates (baked in as defaults, overridable via mount) ─────
# Agent SOUL.md + config.yaml files are gitignored on the host (.deer-flow/),
# so they are NOT copied from the host. Instead, create a placeholder directory
# and let the entrypoint copy from the mounted /app/agents volume at runtime.
RUN mkdir -p /app/agents-templates

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf.template

# ── Entrypoint: starts backend + frontend + nginx ─────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 2026 8001 3000

# Environment defaults (overridden by docker-compose env_file)
ENV DEER_FLOW_PROJECT_ROOT=/app \
    DEER_FLOW_HOME=/app/data \
    DEER_FLOW_CONFIG_PATH=/app/config/config.yaml \
    DEER_FLOW_EXTENSIONS_CONFIG_PATH=/app/config/extensions_config.json \
    PYTHONPATH=/app/backend

# Copy entrypoint script (ensure LF line endings)
COPY docker/pacgate-entrypoint.sh /usr/local/bin/pacgate-entrypoint.sh
RUN chmod +x /usr/local/bin/pacgate-entrypoint.sh

CMD ["pacgate-entrypoint.sh"]